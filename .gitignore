
# Remove-Item -Recurse -Force .git : Removing whole git
@"
# === MODELS - NEVER PUSH TO GITHUB ===
*.cbm
*.ckpt
*.pt
*.pth
*.bin
*.db
*.sqlite
*.onnx
*.h5
*.pkl

# Folders with huge checkpoints
modules/*_dmpnn_ensemble/
modules/increments/
modules/lineage/
modules/locks/
DIT_model/
catboost_info/
feature_cache/
data/
logs/
checkpoints/

# Python cache
__pycache__/
.mypy_cache/
.venv/

# Keep small tracking files - force add with -f
!*.json
!*.jsonl
!benchmark*.txt
"@ | Set-Content -Path .gitignore -Encoding utf8 -Force